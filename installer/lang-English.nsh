; Every message of Tauri's NSIS template. A file named in customLanguageFiles replaces Tauri's own
; file for its language, so it must define every string, or that text is blank in the installer.
LangString addOrReinstall ${LANG_ENGLISH} "Add or reinstall components"
LangString alreadyInstalled ${LANG_ENGLISH} "Already installed"
LangString alreadyInstalledLong ${LANG_ENGLISH} "${PRODUCTNAME} ${VERSION} is already installed. Choose what you want to do, then click Next."
LangString appRunning ${LANG_ENGLISH} "${PRODUCTNAME} is running. Close it, then try again."
LangString appRunningOkKill ${LANG_ENGLISH} "${PRODUCTNAME} is running.$\nClick OK to close it."
LangString chooseMaintenanceOption ${LANG_ENGLISH} "Choose the maintenance option to perform."
LangString chooseHowToInstall ${LANG_ENGLISH} "Choose how you want to install ${PRODUCTNAME}."
LangString createDesktop ${LANG_ENGLISH} "Create a desktop shortcut"
LangString dontUninstall ${LANG_ENGLISH} "Do not uninstall"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "Do not uninstall (this installer cannot install an older version without uninstalling first)"
LangString failedToKillApp ${LANG_ENGLISH} "Could not close ${PRODUCTNAME}. Close it, then try again."
LangString installingWebview2 ${LANG_ENGLISH} "Installing WebView2..."
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer version of ${PRODUCTNAME} is already installed. Installing an older version is not recommended. If you want this older version, uninstall the current one first. Choose what you want to do, then click Next."
LangString older ${LANG_ENGLISH} "older"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "An $R4 version of ${PRODUCTNAME} is installed on this computer. Uninstall it before you install this one. Choose what you want to do, then click Next."
LangString silentDowngrades ${LANG_ENGLISH} "This installer cannot install an older version in silent mode. Run it without silent mode instead.$\n"
LangString unableToUninstall ${LANG_ENGLISH} "Could not uninstall."
LangString uninstallApp ${LANG_ENGLISH} "Uninstall ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "Uninstall before installing"
LangString unknown ${LANG_ENGLISH} "unknown"
LangString webview2AbortError ${LANG_ENGLISH} "Could not install WebView2. The app cannot run without it. Run the installer again."
LangString webview2DownloadError ${LANG_ENGLISH} "Error: could not download WebView2 - $0"
LangString webview2DownloadSuccess ${LANG_ENGLISH} "Downloaded the WebView2 installer"
LangString webview2Downloading ${LANG_ENGLISH} "Downloading the WebView2 installer..."
LangString webview2InstallError ${LANG_ENGLISH} "Error: WebView2 installation failed with exit code $1"
LangString webview2InstallSuccess ${LANG_ENGLISH} "Installed WebView2"
LangString deleteAppData ${LANG_ENGLISH} "Also delete downloaded models, runtimes and projects (leave unticked to keep them)"
