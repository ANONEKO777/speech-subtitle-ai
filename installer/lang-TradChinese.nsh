; Every message of Tauri's NSIS template. A file named in customLanguageFiles replaces Tauri's own
; file for its language, so it must define every string, or that text is blank in the installer.
LangString addOrReinstall ${LANG_TRADCHINESE} "新增或重新安裝元件"
LangString alreadyInstalled ${LANG_TRADCHINESE} "已經安裝"
LangString alreadyInstalledLong ${LANG_TRADCHINESE} "已經安裝 ${PRODUCTNAME} ${VERSION}。請選擇要進行的操作，然後按「下一步」。"
LangString appRunning ${LANG_TRADCHINESE} "${PRODUCTNAME} 正在執行。請先關閉它，再試一次。"
LangString appRunningOkKill ${LANG_TRADCHINESE} "${PRODUCTNAME} 正在執行。$\n按「確定」關閉它。"
LangString chooseMaintenanceOption ${LANG_TRADCHINESE} "請選擇要進行的維護選項。"
LangString chooseHowToInstall ${LANG_TRADCHINESE} "請選擇 ${PRODUCTNAME} 的安裝方式。"
LangString createDesktop ${LANG_TRADCHINESE} "建立桌面捷徑"
LangString dontUninstall ${LANG_TRADCHINESE} "不要解除安裝"
LangString dontUninstallDowngrade ${LANG_TRADCHINESE} "不要解除安裝（這個安裝程式必須先解除安裝，才能安裝較舊的版本）"
LangString failedToKillApp ${LANG_TRADCHINESE} "無法關閉 ${PRODUCTNAME}。請先關閉它，再試一次。"
LangString installingWebview2 ${LANG_TRADCHINESE} "正在安裝 WebView2..."
LangString newerVersionInstalled ${LANG_TRADCHINESE} "已經安裝較新版本的 ${PRODUCTNAME}，不建議安裝舊版。如果確定要安裝這個舊版，最好先解除安裝目前的版本。請選擇要進行的操作，然後按「下一步」。"
LangString older ${LANG_TRADCHINESE} "較舊"
LangString olderOrUnknownVersionInstalled ${LANG_TRADCHINESE} "這台電腦已經安裝 ${PRODUCTNAME} 的 $R4 版本。建議先解除安裝目前的版本再安裝。請選擇要進行的操作，然後按「下一步」。"
LangString silentDowngrades ${LANG_TRADCHINESE} "這個安裝程式不能在靜默模式下安裝較舊的版本，請改用一般的安裝畫面。$\n"
LangString unableToUninstall ${LANG_TRADCHINESE} "無法解除安裝。"
LangString uninstallApp ${LANG_TRADCHINESE} "解除安裝 ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_TRADCHINESE} "安裝前先解除安裝"
LangString unknown ${LANG_TRADCHINESE} "未知"
LangString webview2AbortError ${LANG_TRADCHINESE} "無法安裝 WebView2。沒有 WebView2，這個程式無法執行。請重新執行安裝程式。"
LangString webview2DownloadError ${LANG_TRADCHINESE} "錯誤：無法下載 WebView2 - $0"
LangString webview2DownloadSuccess ${LANG_TRADCHINESE} "已下載 WebView2 安裝程式"
LangString webview2Downloading ${LANG_TRADCHINESE} "正在下載 WebView2 安裝程式..."
LangString webview2InstallError ${LANG_TRADCHINESE} "錯誤：WebView2 安裝失敗，結束代碼 $1"
LangString webview2InstallSuccess ${LANG_TRADCHINESE} "已安裝 WebView2"
LangString deleteAppData ${LANG_TRADCHINESE} "同時刪除已下載的模型、執行環境與專案資料（不勾選則保留）"
