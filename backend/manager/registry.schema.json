{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video-subtitle-translator registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models", "runtimes"],
  "properties": {
    "schema_version": {"const": 1},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}},
    "runtimes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/runtime"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "file": {"type": "string", "pattern": "^(?!\\.{1,2}$)[^/\\\\:]+$"},
    "relative_path": {
      "type": "string",
      "pattern": "^(?:(?!\\.{1,2}(?:/|$))[^/\\\\:]+/)*(?!\\.{1,2}$)[^/\\\\:]+$"
    },
    "needs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "engine", "version", "url", "file", "sha256", "size_bytes",
        "license", "license_url", "vram_mib", "params_b", "needs"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["asr", "aligner", "vad", "llm"]},
        "engine": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "url": {"$ref": "#/$defs/url"},
        "file": {"$ref": "#/$defs/file"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "license": {"type": "string", "minLength": 1},
        "license_url": {"$ref": "#/$defs/url"},
        "vram_mib": {"type": ["integer", "null"], "minimum": 1},
        "params_b": {"type": ["integer", "null"], "minimum": 1},
        "needs": {"$ref": "#/$defs/needs"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "engine", "version", "platform", "backend", "url", "file", "sha256",
        "size_bytes", "license", "license_url", "executable", "min_driver", "ascii_paths_only", "needs"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "engine": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "platform": {"enum": ["win-x64", "macos-arm64"]},
        "backend": {"enum": ["cuda", "cpu", "metal"]},
        "url": {},
        "file": {},
        "sha256": {},
        "size_bytes": {},
        "license": {"type": "string", "minLength": 1},
        "license_url": {"$ref": "#/$defs/url"},
        "executable": {"anyOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "min_driver": {"type": ["string", "null"], "pattern": "^\\d+\\.\\d+$"},
        "ascii_paths_only": {"type": "boolean"},
        "needs": {"$ref": "#/$defs/needs"},
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["script", "source_url"],
          "properties": {
            "script": {"$ref": "#/$defs/relative_path"},
            "source_url": {"$ref": "#/$defs/url"}
          }
        }
      },
      "if": {"required": ["build"]},
      "then": {
        "properties": {
          "url": {"type": "null"},
          "file": {"type": "null"},
          "sha256": {"type": "null"},
          "size_bytes": {"type": "null"},
          "executable": {"$ref": "#/$defs/relative_path"}
        }
      },
      "else": {
        "properties": {
          "url": {"$ref": "#/$defs/url"},
          "file": {"$ref": "#/$defs/file"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
