{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Subtitle Translator",
  "version": "0.1.0",
  "identifier": "app.videosubtitletranslator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "字幕翻譯",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' asset: http://asset.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "speech-subtitle-ai",
    "copyright": "AGPL-3.0-or-later",
    "shortDescription": "Local English-to-Traditional-Chinese subtitle translator",
    "resources": {
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../../installer/THIRD_PARTY.md": "THIRD_PARTY.md",
      "../../LICENSE": "LICENSE",
      "../../installer/LICENSE-whisper.cpp.txt": "licenses/LICENSE-whisper.cpp.txt"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": [
          "TradChinese",
          "English"
        ],
        "installerHooks": "../../installer/hooks.nsh",
        "customLanguageFiles": {
          "TradChinese": "../../installer/lang-TradChinese.nsh",
          "English": "../../installer/lang-English.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwMUQyQkZFOEQ3QkQ0QjMKUldTejFIdU4vaXNkVU56bFJmUnozZjRmbDhtY2RBT0JSdzMwTmVaSUdrRkp0OWFrOTE0WTg2ckcK",
      "endpoints": [
        "https://github.com/ANONEKO777/speech-subtitle-ai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
